{
  "name": "nondum-scio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PDF-werkbank in de browser: alles lokaal, niets wordt geüpload.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.ts && node scripts/copy-ocr-assets.ts",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.ts && node scripts/copy-ocr-assets.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/nld": "^1.0.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "preact": "^11.2.0",
    "tesseract.js": "^7.0.0"
  }
}
